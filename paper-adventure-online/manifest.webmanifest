{
  "name": "Felix's Paper Adventure Together",
  "short_name": "Paper Together",
  "description": "Two players, two devices: work together through Felix's paper levels. Stand on your friend's head, hold the gate, and reach the door together!",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "landscape",
  "background_color": "#fbfaf5",
  "theme_color": "#fbfaf5",
  "icons": [
    {"src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ]
}
